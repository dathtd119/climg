# vJunos-switch: apply the lab USERNAME/PASSWORD to the login user and root at boot.
# init.conf hard-coded admin / admin@123 and launch.py ignored --username/--password.
# The password is written as a SHA-512 hash (passlib is in the vrnetlab base image); defaults kept without credentials.
diff --git a/juniper/vjunosswitch/docker/init.conf b/juniper/vjunosswitch/docker/init.conf
index 8b09f70..5257624 100644
--- a/juniper/vjunosswitch/docker/init.conf
+++ b/juniper/vjunosswitch/docker/init.conf
@@ -1,13 +1,13 @@
 system {
     host-name {HOSTNAME};
     root-authentication {
-        plain-text-password-value "admin@123";
+        {ROOT_AUTHENTICATION}
     }
     login {
-        user admin {
+        user {LOGIN_USER} {
             class super-user;
             authentication {
-                plain-text-password-value "admin@123";
+                {USER_AUTHENTICATION}
             }
         }
     }
diff --git a/juniper/vjunosswitch/docker/launch.py b/juniper/vjunosswitch/docker/launch.py
index bcb9122..c10c23c 100755
--- a/juniper/vjunosswitch/docker/launch.py
+++ b/juniper/vjunosswitch/docker/launch.py
@@ -3,13 +3,20 @@ import datetime
 import logging
 import os
 import signal
+import re
 import subprocess
 import sys
 
 import vrnetlab
+from passlib.hash import sha512_crypt
 
 # loadable startup config
 STARTUP_CONFIG_FILE = "/config/startup-config.cfg"
+# login used when the launcher is not given lab credentials (init.conf defaults)
+DEFAULT_USERNAME = "admin"
+DEFAULT_PASSWORD = "admin@123"
+# Junos login names accepted from the lab credentials
+USERNAME_RE = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}$")
 # initial configuration rendered from the init.conf template on every start
 JUNIPER_CONFIG_FILE = "juniper.conf"
 
@@ -43,8 +50,8 @@ class VJUNOSSWITCH_vm(vrnetlab.VM):
     def __init__(self, hostname, username, password, conn_mode):
         disk_image = vrnetlab.find_disk_image()
         super(VJUNOSSWITCH_vm, self).__init__(
-            username,
-            password,
+            username or DEFAULT_USERNAME,
+            password or DEFAULT_PASSWORD,
             disk_image=disk_image,
             ram=5120,
             driveif="virtio",
@@ -55,6 +62,20 @@ class VJUNOSSWITCH_vm(vrnetlab.VM):
         # device hostname
         self.hostname = hostname
 
+        # lab credentials (containerlab USERNAME / PASSWORD) become the login user and
+        # the root password; without them the init.conf defaults stay. The password is
+        # stored as a SHA-512 hash and is never logged.
+        if username and password:
+            if not USERNAME_RE.match(username):
+                raise ValueError(f"unsupported username {username!r} for a Junos login")
+            password_hash = sha512_crypt.hash(password)
+            login_user = username
+            root_auth = f'encrypted-password "{password_hash}";'
+            user_auth = root_auth
+        else:
+            login_user = DEFAULT_USERNAME
+            root_auth = user_auth = f'plain-text-password-value "{DEFAULT_PASSWORD}";'
+
         # read init.conf configuration file to replace hostname placehodler
         # with given hostname
         with open("init.conf", "r") as file:
@@ -79,6 +100,9 @@ class VJUNOSSWITCH_vm(vrnetlab.VM):
             .replace("{MGMT_IPV6_ADDRESS_CONFIG}", ipv6_address_config)
             .replace("{MGMT_IPV6_ROUTE_CONFIG}", ipv6_route_config)
             .replace("{HOSTNAME}", self.hostname)
+            .replace("{LOGIN_USER}", login_user)
+            .replace("{ROOT_AUTHENTICATION}", root_auth)
+            .replace("{USER_AUTHENTICATION}", user_auth)
         )
 
         # write the rendered config to juniper.conf, keep init.conf intact
@@ -188,8 +212,8 @@ if __name__ == "__main__":
     parser.add_argument(
         "--hostname", default="vr-vjunosswitch", help="vJunos-switch hostname"
     )
-    parser.add_argument("--username", default="vrnetlab", help="Username")
-    parser.add_argument("--password", default="VR-netlab9", help="Password")
+    parser.add_argument("--username", default=None, help="Username")
+    parser.add_argument("--password", default=None, help="Password")
     parser.add_argument(
         "--connection-mode", default="tc", help="Connection mode to use in the datapath"
     )
